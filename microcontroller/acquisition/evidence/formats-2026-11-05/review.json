  "review_cycles": [
    {
      "focus": "exact geometry and representation",
      "resolution": "freeze six byte layouts; explicit little endian, signed18 in i32, zero reserved fields, magic/version and actual-length rejection"
    },
    {
      "focus": "record truth and integrity",
      "resolution": "canonical flags, positional status, present prefixes and incomplete trailer handling; independently recompute ADC CRC16 and block CRC32C"
    },
    {
      "focus": "configuration and epoch context",
      "resolution": "separate opaque manifest byte binding from physical qualification; retain ACE1 on ARM; nonzero origin; immutable validated context and raw provenance"
    },
    {
      "focus": "ownership and ABA",
      "resolution": "lease includes session, ring index and full generation; PUB1 alone cannot prove ownership; explicit zero-publication precedence and immutable leased snapshot"
    },
    {
      "focus": "partial blocks and loss namespaces",
      "resolution": "partial blocks are final; no padding exported; exact producer loss excludes all published records; archive gaps and uncertain envelopes have separate counting rules"
    },
    {
      "focus": "unbound arithmetic",
      "resolution": "reject impossible ACL1 origin/spacing/known endpoints and impossible inferred full ACD1 ring maps even before external binding"
    },
    {
      "focus": "epoch chronology",
      "resolution": "new-epoch order uses ACE1 origin even with missing prefixes; loss-only exact epochs contribute occupied endpoints; uncertain envelopes do not fabricate occupancy"
    },
    {
      "focus": "finite publication histories",
      "resolution": "reject sequence gaps exceeding finite prior/intermediate epoch capacities; tighten old tail before a new origin on the same timebase; correct impossible exhaustion fixture"
    },
    {
      "focus": "storage and service",
      "resolution": "account separately for 4096-byte descriptor table and 4-byte retirement store; bound retirement service without blocking drain"
    },
    {
      "focus": "comments and final independent review",
      "resolution": "retain initial three comment findings and correct them; final 216-file audit passes; independent reviewer confirms all targeted residuals fixed and r4 source hashes match"
    }
  ],
