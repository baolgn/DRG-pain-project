  "review_cycles": [
    {
      "focus": "clock/domain/reset inventory",
      "resolution": "fixed acquisition clock and CE-driven serial output; separate continuously running system owners and independent supervisor; CPU reset cannot clear peripheral authority"
    },
    {
      "focus": "coherent messages and snapshot semantics",
      "resolution": "four-phase retained payload/reply channels; exact identities and separate admission/completion; scalar controls are not tagged messages; source-domain snapshots are not falsely simultaneous"
    },
    {
      "focus": "FIFO capacity and immutable context",
      "resolution": "56-byte entries retain record48 plus slot64; 14 KiB payload and <=2 KiB declared metadata/staging within 16 KiB; no extra owner beyond 514-record tail"
    },
    {
      "focus": "reset race and isolation order",
      "resolution": "allow late old-context transfers until each endpoint parks; crossing-visible history clears only after bilateral fence or physically proven abrupt-reset fence ordering"
    },
    {
      "focus": "publication and missing terminal authority",
      "resolution": "offered PUB1 may commit after acquisition reset; preserve old owner and quarantine until matching visibility/containment; explicit INCOMPLETE recovery avoids fake or impossible ACK_TERMINAL"
    },
    {
      "focus": "ARM-created timing binding",
      "resolution": "prepare static context only; accepted ARM creates ACE1, first tick A+1; gate S reads until exact metadata arrives without CPU wait or delayed first slot"
    },
    {
      "focus": "first-record timing",
      "resolution": "early stop placeholder exposes metadata wait; ACE copy24 ticks normal/deadline32 and transfer32 fit56 normal/64 accepted; all remote observation delay charged within64/80 handoff budgets"
    },
    {
      "focus": "independent progress watchdogs",
      "resolution": "per-target retained challenges avoid sampling aliasing; responders outside functional reset; independent80-tick timers include last in-flight response, return-to-zero and isolation; no cross-target refresh"
    },
    {
      "focus": "STOP request retirement",
      "resolution": "active request retires separately from sticky cause history; no-epoch ALREADY_STOPPED needs no invented terminal; actual faults still require recovery"
    },
    {
      "focus": "nonvacuity and causal model checks",
      "resolution": "add covered reset phases and causal transition checks; broken controls demonstrate silent request withdrawal and joint slot/record fabrication are caught"
    },
    {
      "focus": "independent reset observation and epoch metadata models",
      "resolution": "separate source CPU reset from destination STOP observation; explicit settling waits; model delayed/stale ARM metadata and pre-binding read rejection"
    },
    {
      "focus": "final independent review",
      "resolution": "CDC and reset reviewers found no remaining targeted logical contradiction after timing and STOP clarifications; root verified retained source hashes, arithmetic, syntax, comments and links"
    }
  ],
  "finite_model_scope": [
    "finite abstract state exploration, not an RTL or analog CDC proof",
    "two commands; retained endpoints; source reset and destination STOP observation are independent",
    "two-stage control crossings plus explicit further-edge payload/reply settling waits",
    "depth-two FIFO; five records; one coordinated replacement across two link identities",
    "prepared context and ARM-created ACE1; one record per context across two sessions; delayed metadata",
    "one allocation/transaction/lease plus offered/accepted/visible PUB1 phases",
    "one symbolic scheduled slot; controlled STOP versus abrupt acquisition reset",
    "coherent Gray-pointer samples and stable bundled data are assumed physical obligations",
    "state exhaustion proves safety only for these finite abstractions; no fairness or deadline proof"
  ],
