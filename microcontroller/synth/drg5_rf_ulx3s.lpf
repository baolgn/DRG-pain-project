# use upstream v316 pin constraints for the ULX3S v3.1.7 D&M target.
LOCATE COMP "clk25_i" SITE "G2";
IOBUF PORT "clk25_i" IO_TYPE=LVCMOS33 PULLMODE=NONE;
FREQUENCY PORT "clk25_i" 25.000 MHZ;
LOCATE COMP "serial_i" SITE "R1";
IOBUF PORT "serial_i" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "led_o[0]" SITE "B2";
LOCATE COMP "led_o[1]" SITE "C2";
LOCATE COMP "led_o[2]" SITE "C1";
LOCATE COMP "led_o[3]" SITE "D2";
LOCATE COMP "led_o[4]" SITE "D1";
LOCATE COMP "led_o[5]" SITE "E2";
LOCATE COMP "led_o[6]" SITE "E1";
LOCATE COMP "led_o[7]" SITE "H3";
IOBUF PORT "led_o[0]" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=NONE;
IOBUF PORT "led_o[1]" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=NONE;
IOBUF PORT "led_o[2]" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=NONE;
IOBUF PORT "led_o[3]" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=NONE;
IOBUF PORT "led_o[4]" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=NONE;
IOBUF PORT "led_o[5]" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=NONE;
IOBUF PORT "led_o[6]" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=NONE;
IOBUF PORT "led_o[7]" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=NONE;
